{
  "name": "@gogz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --conditions=source src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=source --env-file-if-exists=../../.env src/db/seed-cli.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@gogz/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/blob": "^2.9.0",
    "arctic": "^3.7.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
