# Local Postgres (Homebrew). On Vercel this is set by the Neon integration (use the pooled URL).
DATABASE_URL=postgres://localhost:5432/gogz_dev

# Public URL of the web app (Vite dev server locally). Used for SMS links and the CSRF origin check.
APP_ORIGIN=http://localhost:5173

# Your Google email: allowlisted as admin by `npm run db:seed`.
ADMIN_EMAIL=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, "Web application").
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback (plus your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio. Leave blank locally: texts are printed to the API terminal instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel Blob for profile pictures. Leave blank locally: images are stored inline.
BLOB_READ_WRITE_TOKEN=

# Protects the nightly demo-reset cron endpoint.
CRON_SECRET=
